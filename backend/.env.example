# Port number for the Express server
PORT=5000

# MongoDB Atlas connection string (Tier 3)
# Replace with your actual credentials from MongoDB Atlas:
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/hospitalDB?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hospitalDB?retryWrites=true&w=majority

# Netlify Frontend URL (Tier 1) for strict CORS in production
# e.g., https://hospital-patient-system.netlify.app
FRONTEND_URL=https://your-hospital-frontend.netlify.app

# Environment Mode
NODE_ENV=development
